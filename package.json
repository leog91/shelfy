{
  "name": "shelfy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup": "bun scripts/setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "icons:generate": "bun scripts/generate-favicon.ts",
    "format": "prettier --write app components lib tests scripts *.ts *.mts *.json docs/*.md README.md AGENTS.md",
    "format:check": "prettier --check app components lib tests scripts *.ts *.mts *.json docs/*.md README.md AGENTS.md"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@next/env": "^16.4.3",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-auth": "^1.7.12",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
