# Run bun run setup to create .env.local with a fresh random local secret.
DATABASE_URL=libsql://your-database.turso.io
# Server-only Turso token (never NEXT_PUBLIC_):
DATABASE_AUTH_TOKEN=
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Default closed unless explicitly true. Turn false after creating personal account(s).
ALLOW_SIGN_UP=true

# Clipsy app origin (public deployment setting, not a per-user credential).
# Defaults to the hosted Clipsy app. HTTP loopback is allowed only outside production.
CLIPSY_URL=https://clipsy-web-sepia.vercel.app
